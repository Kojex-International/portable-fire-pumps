---
import SectionHeader from '../layout/SectionHeading.astro';
import promoPosterImg from '@assets/videos/shibaura-promo-text-poster.webp';

interface Props {
  locale: 'en' | 'fr';
}

const { locale } = Astro.props;

const copy = {
  en: {
    badge: 'Featured Video',
    title: 'See Shibaura',
    highlight: 'In Action',
    description:
      'Watch the pumps in real-world operation before comparing the models best suited to your deployment.',
  },
  fr: {
    badge: 'Video en vedette',
    title: 'Voir Shibaura',
    highlight: 'En action',
    description:
      'Découvrez les pompes en situation réelle avant de comparer les modèles les mieux adaptés a votre deploiement.',
  },
} as const;

const content = copy[locale];
---

<section class="bg-white pt-12 pb-4 lg:pt-16 lg:pb-6">
  <div class="container mx-auto mobile-container-gutter">
    <SectionHeader
      badge={content.badge}
      title={content.title}
      highlight={content.highlight}
      description={content.description}
      class="mb-8"
    />

    <div class="px-2 md:px-3">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="aspect-video bg-slate-950">
          <video
            class="block h-full w-full object-cover"
            controls
            preload="metadata"
            poster={promoPosterImg.src}
          >
            <source media="(max-width: 767px)" src="/videos/promo/shibaura-promo-text-mobile.mp4" type="video/mp4" />
            <source src="/videos/promo/shibaura-promo-text-desktop.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </div>
</section>
