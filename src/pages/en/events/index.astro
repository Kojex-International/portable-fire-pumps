---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/layout/Section.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import EventProductHeroCard from '@components/events/EventProductHeroCard.astro';
import EventPremiumVideoHero from '@components/events/EventPremiumVideoHero.astro';
import {
  ArrowRight,
  CheckCircle2,
  Download,
  Factory,
  Flame,
  Handshake,
  LifeBuoy,
  ShieldCheck,
  Wrench,
} from 'lucide-react';
import heroBgImg from '@assets/product-features-hero.webp';
import shibauraLogoMark from '@assets/shibaura-logo-mark.svg?url';
import easternCanadaDistributorImg from '@assets/distributors/larsenal-distributor-logo.svg';
import westernCanadaDistributorImg from '@assets/distributors/flash-wildfire-services-logo.avif';
import catalogPdf from '../../../data/Shibaura_Catalog2024_9.pdf';
import { getFirepumps } from '../../../data/firepumps';
import { getHeroFeatureLabel } from '../../../i18n/heroFeatureLabels';
import { localizePath } from '@config/site';
import { getNonProductMetadata } from '@utils/nonProductMetadata';

const locale = 'en';
const metadata = getNonProductMetadata({
  pageKey: 'events',
  locale,
  pathname: Astro.url.pathname,
  ogImageSrc: heroBgImg.src,
});

const tradeShowEvent = {
  isActive: false,
  tradeShowName: '',
  boothNumber: '',
  eventDates: '',
} as const;

const firepumps = getFirepumps(locale);
const ff500 = firepumps.find((pump) => pump.slug === 'ff500ar-a');
const p572 = firepumps.find((pump) => pump.slug === 'p572s-a');

if (!ff500 || !p572) {
  throw new Error('Expected featured event pumps to exist in firepump data.');
}

const contactHref = '/en/contact-us?source=trade-show-qr';
const dealerContactHref = '/en/contact-us?interest=dealer&source=trade-show-qr';
const ff500Href = localizePath('/products/ff500ar-a', locale);
const p572Href = localizePath('/products/p572s-a', locale);
const resourcesHref = localizePath('/resources', locale);

const shibauraReasons = [
  {
    title: 'Leading Performance in Automatic Relay Pumping',
    description: 'Industry-leading technology for long-distance water relay operations.',
    icon: Flame,
  },
  {
    title: '70+ Years of Japanese Engineering',
    description: 'Trusted pump manufacturer since 1950.',
    icon: Factory,
  },
  {
    title: 'Nationwide KOJEX Support',
    description: 'Direct technical support, warranty claims and parts processing, marketing resources, and joint sales support.',
    icon: Wrench,
  },
  {
    title: 'Proven Reliability',
    description: 'Trusted by fire departments and emergency responders in demanding environments.',
    icon: ShieldCheck,
  },
] as const;

const dealers = [
  {
    name: "L'Arsenal",
    region: 'Quebec',
    image: easternCanadaDistributorImg,
  },
  {
    name: 'Flash Wildfire',
    region: 'Alberta, Saskatchewan & British Columbia',
    image: westernCanadaDistributorImg,
  },
] as const;

const resourceLinks = [
  {
    title: 'Product Catalogue',
    description: 'Download the current Shibaura portable fire pump catalogue used at the booth.',
    href: catalogPdf,
    cta: 'Download Catalogue',
    icon: Download,
  },
  {
    title: 'One-Page Brochure',
    description: 'A concise sales handout for post-show follow-up and pump selection conversations.',
    href: resourcesHref,
    cta: 'View Resource Library',
    icon: ArrowRight,
  },
] as const;

const buildHeroSpecs = (pump: (typeof firepumps)[number]) => {
  const keySpecByKey = new Map(pump.keySpecs.map((spec) => [spec.key, spec]));
  const orderedKeys = ['coolingSystem', 'pumpModel', 'engineType', 'maxPressure', 'primingTime', 'flowRate'] as const;

  return orderedKeys
    .map((key) => keySpecByKey.get(key))
    .filter((spec): spec is NonNullable<typeof spec> => Boolean(spec))
    .map((spec) => {
      const rawValue = typeof spec.value === 'string' ? spec.value : spec.value[locale];
      const normalizedValue = spec.key === 'flowRate' ? rawValue.replace(/\bgpm\b/gi, 'US GPM') : rawValue;
      const value =
        pump.slug === 'ff500ar-a' && spec.key === 'flowRate'
          ? '409 US GPM @ 72.5 PSI\n259 US GPM @ 145 PSI'
          : spec.key === 'flowRate'
            ? normalizedValue
            : normalizedValue.replace(/\s*\n\s*/g, ' ');
      return {
        label: spec.label ?? getHeroFeatureLabel(spec.key, locale),
        value,
        icon: spec.icon,
      };
    });
};

const compareCards = [
  {
    pump: ff500,
    positioning: 'Automatic relay pumping for efficient long-distance water movement.',
    heroSpecs: buildHeroSpecs(ff500),
    manualPdf: ff500.manualPdf ?? catalogPdf,
    detailHref: ff500Href,
  },
  {
    pump: p572,
    positioning: 'Maximum flow and exceptional value for high-output firefighting.',
    heroSpecs: buildHeroSpecs(p572),
    manualPdf: p572.manualPdf ?? catalogPdf,
    detailHref: p572Href,
  },
] as const;
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  canonicalUrl={metadata.canonicalUrl}
  ogImage={metadata.ogImageUrl}
  locale="en"
  robots="noindex, nofollow"
>
  <EventPremiumVideoHero
    badge="FDIC Atlantic 2026"
    title="Thanks for Visiting"
    tagline="Delivering Water Where It’s Needed Most"
    description="Explore the pumps, videos, and resources featured at our booth. Learn how Shibaura pumps deliver industry-leading performance with comprehensive North American support."
  />

  {tradeShowEvent.isActive && (
    <Section background="white" id="current-event">
      <div class="mx-auto max-w-4xl">
        <Card class="border border-slate-200 bg-white p-6 shadow-lg sm:p-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Current Event</p>
              <h2 class="mt-2 text-2xl font-bold text-slate-900">{tradeShowEvent.tradeShowName}</h2>
            </div>
            <div class="grid gap-3 text-sm text-slate-600 sm:text-right">
              <div><span class="font-semibold text-slate-900">Booth:</span> {tradeShowEvent.boothNumber}</div>
              <div><span class="font-semibold text-slate-900">Dates:</span> {tradeShowEvent.eventDates}</div>
            </div>
          </div>
        </Card>
      </div>
    </Section>
  )}

  <Section background="white" id="featured-products">
    <div class="mx-auto max-w-6xl space-y-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Featured Products</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Revisit the featured pumps</h2>
      <p class="mx-auto max-w-3xl text-base leading-relaxed text-slate-600">
        Start with the models highlighted at the booth, then jump to the full product pages for detailed performance data and technical information.
      </p>
    </div>

    <div class="mt-5 grid gap-6 lg:grid-cols-2">
      {compareCards.map((card) => (
        <EventProductHeroCard
          pump={card.pump}
          locale={locale}
          positioning={card.positioning}
          heroSpecs={card.heroSpecs}
          manualPdf={card.manualPdf}
          manualLabel="Operations Manual"
          detailHref={card.detailHref}
          detailLabel="Learn More"
          shibauraLogoMark={shibauraLogoMark}
        />
      ))}
    </div>
  </Section>

  <Section background="gray" id="why-choose-shibaura">
    <div class="mx-auto max-w-6xl space-y-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Why Choose Shibaura</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Why Shibaura and KOJEX stand apart</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {shibauraReasons.map((item) => {
        const Icon = item.icon;
        return (
          <Card class="h-full border border-slate-200 bg-white p-6 shadow-lg">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-700 ring-1 ring-rose-100">
              <Icon className="h-6 w-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.description}</p>
          </Card>
        );
      })}
    </div>
  </Section>

  <Section background="white" id="dealer-network">
    <div class="mx-auto max-w-5xl space-y-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Dealer Network</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Trusted Across Canada</h2>
      <p class="text-base leading-relaxed text-slate-600">Current dealer network includes:</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {dealers.map((dealer) => (
        <Card class="border border-slate-200 bg-white p-6 shadow-lg">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-2">
              <Image src={dealer.image} alt={dealer.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
            </div>
            <div class="text-left">
              <h3 class="text-xl font-bold text-slate-900">{dealer.name}</h3>
              <p class="mt-1 text-sm font-medium text-slate-600">{dealer.region}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <div class="mt-8 text-center">
      <Button href={dealerContactHref} variant="outline" size="lg">
        Become a Dealer
      </Button>
    </div>
  </Section>

  <Section background="gray" id="resources">
    <div class="mx-auto max-w-5xl space-y-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Resources</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Download the key sales materials</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {resourceLinks.map((item) => {
        const Icon = item.icon;
        return (
          <Card class="flex h-full flex-col border border-slate-200 bg-white p-6 shadow-lg">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-700 ring-1 ring-slate-200">
              <Icon className="h-6 w-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{item.description}</p>
            <div class="mt-6">
              <Button href={item.href} variant="outline" class="w-full">
                {item.cta}
              </Button>
            </div>
          </Card>
        );
      })}
      {/* TODO: Replace the one-page brochure resource library link with the finalized brochure PDF once the approved file path exists in the repo. */}
    </div>
  </Section>

  <Section background="gradient" id="next-steps" class="overflow-hidden">
    <Card class="border border-slate-200 bg-white/95 p-8 shadow-2xl sm:p-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">Next Steps</p>
        <h2 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">Continue the conversation with KOJEX</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          Reach the existing contact page for pricing, demonstration planning, pump selection guidance, or post-show follow-up.
        </p>
        <div class="mt-6 flex justify-center">
          <Button href={contactHref} size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </Card>
  </Section>
</BaseLayout>
