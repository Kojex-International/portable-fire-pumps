---
import SiteBadge from '@components/ui/SiteBadge.astro';

interface Props {
  badge?: string;
  badgeIcon?: string;
  badgeIconComponent?: any;
  badgeIconClass?: string;
  badgeVariant?: 'hero' | 'brand' | 'neutral';
  badgeTone?: 'red' | 'gray';
  title: string;
  highlight?: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  badge,
  badgeIcon,
  badgeIconComponent,
  badgeIconClass = '',
  badgeVariant,
  badgeTone,
  title,
  highlight,
  description,
  align = 'center',
  class: className = ''
} = Astro.props;

const alignClasses = align === 'left' ? 'text-left' : 'text-center';
const maxWidthClasses = align === 'left' ? 'max-w-4xl' : 'max-w-5xl mx-auto';
const resolvedBadgeVariant = badgeVariant ?? (badgeIcon ? 'brand' : 'neutral');
const resolvedBadgeTone = badgeTone ?? (badgeIcon ? 'red' : 'gray');
---

<div class={`mobile-body-gutter ${alignClasses} ${maxWidthClasses} ${className}`}>
  {badge && (
    <SiteBadge
      label={badge}
      iconUrl={badgeIcon}
      iconComponent={badgeIconComponent}
      iconClass={badgeIconClass}
      variant={resolvedBadgeVariant}
      tone={resolvedBadgeTone}
      class="mb-4"
    />
  )}
  <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
    {title}
    {highlight && <span class="brand-gradient-text"> {highlight}</span>}
  </h2>
  {description && (
    <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
      {description}
    </p>
  )}
  <slot />
</div>
