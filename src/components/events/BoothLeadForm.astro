---
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY || '';
const bookingsEnabled = import.meta.env.PUBLIC_OAFC_BOOKINGS_ENABLED === 'true';
const bookingsUrl = import.meta.env.PUBLIC_OAFC_BOOKINGS_URL || '';
let safeBookingsUrl = '';
try {
  const url = new URL(bookingsUrl);
  if (url.protocol === 'https:' && (url.hostname === 'outlook.office365.com' || url.hostname === 'outlook.office.com')) safeBookingsUrl = url.href;
} catch {}
const inputClass = 'mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900';
---
<section id="booth-form" class="bg-slate-50 py-12 sm:py-16">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--brand-1)]">OAFC 2026 · Booth 60</p>
    <h2 class="mt-2 text-3xl font-bold text-slate-900">Continue the conversation</h2>
    <p class="mt-3 text-slate-600">Tell us about your department and how we can help. Fields marked * are required.</p>
    <form id="booth-lead-form" action="/.netlify/functions/booth-lead" method="post" data-site-key={turnstileSiteKey} class="mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-lg sm:p-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <label>Full name *<input class={inputClass} name="full_name" autocomplete="name" required maxlength="140" /></label>
        <label>Organization *<input class={inputClass} name="organization" autocomplete="organization" required maxlength="140" /></label>
        <label>Title<input class={inputClass} name="title" autocomplete="organization-title" maxlength="140" /></label>
        <label>Phone<input class={inputClass} name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
        <label>Email *<input class={inputClass} name="email" type="email" autocomplete="email" required maxlength="254" /></label>
        <label>Served by *<select class={inputClass} name="served_by" required><option value="">Select a team member</option><option value="will">Will</option><option value="seb">Seb</option><option value="chris">Chris</option><option value="koji">Koji</option></select></label>
      </div>
      <fieldset><legend class="font-semibold">Current pumps</legend><p class="text-sm text-slate-600">Optional. Add any pumps you would like to discuss.</p>
        <div id="pump-rows" class="mt-3 space-y-3"></div>
        <button type="button" id="add-pump" class="mt-3 font-semibold text-[var(--brand-1)] underline">Add a pump</button>
      </fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <label>Interest *<select class={inputClass} name="interest" required><option value="">Select an interest</option><option value="portable_pump">Portable pump</option><option value="demo">Demonstration</option><option value="quote">Quote</option><option value="browsing">Browsing</option></select></label>
        <label>Preferred follow-up *<select class={inputClass} name="preferred_follow_up" required><option value="">Select a follow-up</option><option value="call">Call</option><option value="email">Email</option><option value="demo">Demonstration</option></select></label>
      </div>
      <label class="block">Staff note<textarea class={inputClass} name="staff_note" rows="3" maxlength="1000"></textarea></label>
      <label class="flex items-start gap-3"><input class="mt-1" type="checkbox" name="permission_to_contact" required /> <span>I give KOJEX permission to contact me about this inquiry. *</span></label>
      <div id="booth-turnstile"></div>
      <p id="booth-status" role="status" aria-live="polite" class="text-sm text-red-700"></p>
      <button type="submit" class="rounded-lg bg-[var(--brand-1)] px-6 py-3 font-bold text-white disabled:opacity-50">Send inquiry</button>
    </form>
    {bookingsEnabled && safeBookingsUrl && <div id="booth-booking" hidden class="mt-8"><h3 class="text-xl font-bold">Book a follow-up</h3><p class="mt-2 text-slate-600">Your inquiry has been sent. You can also choose a time below.</p><iframe src={safeBookingsUrl} title="Book a follow-up with KOJEX" loading="lazy" class="mt-4 h-[700px] w-full rounded-lg border border-slate-200"></iframe><a href={safeBookingsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block underline">Open the booking page</a></div>}
    <noscript><p class="mt-4 text-red-700">JavaScript is required to send this form. Please contact KOJEX through the contact page.</p></noscript>
  </div>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script is:inline src="/scripts/booth-lead.js" defer></script>
