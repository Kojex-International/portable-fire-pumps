---
import { Image } from 'astro:assets';
import SiteBadge from '@components/ui/SiteBadge.astro';
import heroPosterDesktop from '@assets/hero-firepump-loop-v1-poster.jpg';
import heroPosterMobile from '@assets/hero-firepump-loop-v1-mobile-poster.jpg';
import kojexWordmarkMask from '@assets/Kojex_wordmark_eventmask.svg?url';
import { Download, FileText, Presentation } from 'lucide-react';

interface QuickDownloadItem {
  title: string;
  subtitle: string;
  href: string;
  icon: 'download' | 'file-text';
}

interface Props {
  badge: string;
  title: string;
  tagline: string;
  description: string;
  quickDownloads?: QuickDownloadItem[];
}

const {
  badge,
  title,
  tagline,
  description,
  quickDownloads = [],
} = Astro.props;

const heroVideoDesktopSrc = '/hero-firepump-loop-v1.mp4';
const heroVideoMobileSrc = '/hero-firepump-loop-v1-mobile.mp4';
---

<section
  class="relative h-[82vh] min-h-[620px] overflow-hidden bg-[#151515]"
  data-event-premium-hero
>
  <div class="absolute inset-0 md:hidden">
    <video
      data-event-premium-hero-video
      data-poster-desktop={heroPosterDesktop.src}
      data-poster-mobile={heroPosterMobile.src}
      class="block h-full w-full object-cover object-center motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={heroPosterMobile.src}
      aria-hidden="true"
      tabindex="-1"
    >
      <source media="(max-width: 767px)" src={heroVideoMobileSrc} type="video/mp4" />
      <source src={heroVideoDesktopSrc} type="video/mp4" />
    </video>
    <picture class="hidden h-full w-full motion-reduce:block">
      <source media="(max-width: 767px)" srcset={heroPosterMobile.src} />
      <Image
        src={heroPosterDesktop}
        alt=""
        class="h-full w-full object-cover object-center"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width={1280}
        height={720}
      />
    </picture>
    <div class="pointer-events-none absolute inset-0 bg-black/45"></div>
    <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-black/20 via-black/35 to-black/60"></div>
  </div>

  <div class="relative z-10 flex h-full w-full flex-col px-6 py-5 sm:px-8 sm:py-6 lg:px-10 lg:py-7">
    <div class="relative z-20 flex shrink-0 items-start justify-center text-center">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <SiteBadge
          label={badge}
          iconComponent={Presentation}
          variant="hero"
        />

        <h1 class="mt-3 text-xl font-bold tracking-tight sm:text-2xl lg:text-4xl">
          <span class="brand-gradient-text-fill">{title}</span>
        </h1>
      </div>
    </div>

    <div
      data-event-premium-hero-mask-row
      class="pointer-events-none relative z-10 hidden flex-1 items-center justify-center overflow-hidden md:flex"
    >
      <div class="flex h-full w-full items-center justify-center py-3 lg:py-4">
        <div
          aria-hidden="true"
          class="relative h-full max-h-[clamp(18rem,52vh,40rem)] w-[90%] overflow-hidden"
          style={`-webkit-mask-image: url(${kojexWordmarkMask}); mask-image: url(${kojexWordmarkMask}); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain;`}
        >
          <img
            src={heroPosterDesktop.src}
            alt=""
            class="absolute inset-0 block h-full w-full object-cover object-center"
          />
          <video
            data-event-premium-hero-video
            data-poster-desktop={heroPosterDesktop.src}
            data-poster-mobile={heroPosterMobile.src}
            class="absolute inset-0 block h-full w-full object-cover object-center motion-reduce:hidden"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={heroPosterDesktop.src}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={heroVideoDesktopSrc} type="video/mp4" />
          </video>
        </div>
      </div>
    </div>

    <div class="relative z-20 flex shrink-0 justify-center text-center">
      <div class="mx-auto w-[90%] max-w-[90%]">
        <p class="mx-auto w-fit max-w-[67%] whitespace-nowrap pb-6 text-[clamp(1.1rem,2vw,2.35rem)] font-semibold uppercase tracking-[0.05em] text-slate-200">
          {tagline}
        </p>

        {description && (
          <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-200 sm:text-base">
            {description}
          </p>
        )}

        {quickDownloads.length > 0 && (
          <div class:list={['mx-auto grid max-w-3xl gap-3 sm:grid-cols-2', description ? 'mt-5' : 'mt-6']}>
            {quickDownloads.map((item) => {
              const Icon = item.icon === 'download' ? Download : FileText;
              return (
                <a
                  href={item.href}
                  download
                  class="group flex items-center justify-center gap-3 rounded-2xl bg-transparent px-3 py-2.5 text-white transition-all duration-300 hover:-translate-y-0.5 sm:px-4"
                >
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-transparent text-white transition-colors duration-300 group-hover:text-red-300">
                    <Icon className="h-5 w-5" />
                  </div>
                  <div class="min-w-0 text-left">
                    <p class="text-sm font-bold leading-tight text-white transition-colors duration-300 group-hover:text-red-300 sm:text-base">{item.title}</p>
                    <p class="mt-1 text-xs leading-snug text-slate-300 sm:text-sm">{item.subtitle}</p>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const syncHeroPoster = () => {
      document.querySelectorAll('[data-event-premium-hero-video]').forEach((video) => {
        if (!(video instanceof HTMLVideoElement)) return;
        const isMobile = window.matchMedia('(max-width: 767px)').matches;
        const nextPoster = isMobile ? video.dataset.posterMobile : video.dataset.posterDesktop;
        if (nextPoster && video.poster !== nextPoster) {
          video.poster = nextPoster;
        }
      });
    };

    syncHeroPoster();
    window.addEventListener('resize', syncHeroPoster, { passive: true });
  })();
</script>
