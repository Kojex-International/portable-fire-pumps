---
import SiteBadge from '@components/ui/SiteBadge.astro';
import heroPosterDesktop from '@assets/hero-firepump-loop-v1-poster.jpg';
import heroPosterMobile from '@assets/hero-firepump-loop-v1-mobile-poster.jpg';
import kojexWordmarkMask from '@assets/Kojex_wordmark_eventmask.svg?url';
import { Clapperboard, Download, FileText, Presentation } from 'lucide-react';

interface QuickDownloadItem {
  title: string;
  subtitle: string;
  href: string;
  icon: 'download' | 'file-text' | 'video';
  download?: boolean;
}

interface Props {
  badge: string;
  title: string;
  tagline: string;
  description: string;
  quickDownloads?: QuickDownloadItem[];
}

const {
  badge,
  title,
  tagline,
  description,
  quickDownloads = [],
} = Astro.props;

const heroVideoDesktopSrc = '/hero-firepump-loop-v1.mp4';
const heroVideoMobileSrc = heroVideoDesktopSrc;
---

<section
  class="relative min-h-[460px] overflow-hidden bg-[#151515] md:h-[82vh] md:min-h-[620px]"
  data-event-premium-hero
>
  <div class="relative z-10 flex h-full w-full flex-col px-3 py-5 sm:px-8 sm:py-6 lg:px-10 lg:py-7">
    <div class="relative z-20 flex shrink-0 items-start justify-center text-center">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <SiteBadge
          label={badge}
          iconComponent={Presentation}
          variant="hero"
        />

        <h1 class="mt-3 text-xl font-bold tracking-tight sm:text-2xl lg:text-4xl">
          <span class="brand-gradient-text-fill">{title}</span>
        </h1>
      </div>
    </div>

    <div
      data-event-premium-hero-mask-row
      class="pointer-events-none relative z-10 mt-3 flex flex-none items-center justify-center overflow-hidden md:mt-0 md:flex-1"
    >
      <div class="relative flex w-full items-center justify-center py-1 md:h-full md:py-3 lg:py-4">
        <div
          aria-hidden="true"
          class="event-premium-hero-mask relative w-[95%] overflow-hidden md:h-full md:max-h-[clamp(18rem,52vh,40rem)] md:w-[90%]"
          style={`-webkit-mask-image: url(${kojexWordmarkMask}); mask-image: url(${kojexWordmarkMask}); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center;`}
        >
          <img
            data-event-premium-hero-poster
            src={heroPosterDesktop.src}
            alt=""
            class="event-premium-hero-mask-media absolute -inset-y-px -left-px -right-px block h-[calc(100%+2px)] w-[calc(100%+2px)] max-w-none object-cover object-center"
          />
          <!--
            Safari autoplay: set src on <video> (no <source> children), muted+playsinline
            as attributes and JS properties. Avoid video.load() — it aborts the first play().
          -->
          <video
            data-event-premium-hero-video
            data-src-desktop={heroVideoDesktopSrc}
            data-src-mobile={heroVideoMobileSrc}
            data-poster-desktop={heroPosterDesktop.src}
            data-poster-mobile={heroPosterMobile.src}
            class="event-premium-hero-mask-media absolute -inset-y-px -left-px -right-px block h-[calc(100%+2px)] w-[calc(100%+2px)] max-w-none object-cover object-center motion-reduce:hidden"
            src={heroVideoDesktopSrc}
            autoplay
            muted
            defaultMuted
            loop
            playsinline
            webkit-playsinline
            preload="auto"
            poster={heroPosterDesktop.src}
            disableRemotePlayback
            aria-hidden="true"
            tabindex="-1"
          ></video>
          <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-[4px] bg-[#151515] md:hidden"></div>
        </div>
      </div>
    </div>

    <div class="relative z-20 flex shrink-0 justify-center text-center">
      <div class="mx-auto w-[90%] max-w-[90%]">
        <p class="mx-auto max-w-[84%] pb-4 text-center text-[clamp(1rem,4.2vw,2.35rem)] font-semibold uppercase leading-tight tracking-[0.05em] text-slate-200 md:max-w-[67%] md:whitespace-nowrap md:pb-6 md:text-[clamp(1.1rem,2vw,2.35rem)]">
          {tagline}
        </p>

        {description && (
          <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-200 sm:text-base">
            {description}
          </p>
        )}

        {quickDownloads.length > 0 && (
          <div class:list={['mx-auto flex w-fit flex-col items-center justify-center gap-2 md:flex-row md:flex-wrap', description ? 'mt-4' : 'mt-3 md:mt-6']}>
            {quickDownloads.map((item) => {
              const Icon =
                item.icon === 'download'
                  ? Download
                  : item.icon === 'video'
                    ? Clapperboard
                    : FileText;
              return (
                <a
                  href={item.href}
                  download={item.download ? true : undefined}
                  class="group inline-flex w-auto min-w-0 items-center justify-center gap-3 rounded-2xl bg-transparent px-3 py-2 text-white transition-all duration-300 hover:-translate-y-0.5 sm:px-4 sm:py-2.5"
                >
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-transparent text-white transition-colors duration-300 group-hover:text-red-300">
                    <Icon className="h-5 w-5" />
                  </div>
                  <div class="min-w-0 text-left">
                    <p class="text-sm font-bold leading-tight text-white transition-colors duration-300 group-hover:text-red-300 sm:text-base">{item.title}</p>
                    <p class="mt-1 text-xs leading-snug text-slate-300 sm:text-sm">{item.subtitle}</p>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Use contain on all breakpoints so letter proportions match desktop Safari.
    100% 100% stretch + subpixel aspect rounding on iOS made the wordmark look
    like a different font.
  */
  .event-premium-hero-mask {
    aspect-ratio: 81.17343 / 33.403266;
    height: auto;
    background-color: #151515;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-mode: alpha;
    mask-mode: alpha;
  }

  .event-premium-hero-mask-media {
    transform: translate3d(1.5%, 0, 0) scale(1.14);
    transform-origin: center;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  @media (min-width: 768px) {
    .event-premium-hero-mask {
      aspect-ratio: auto;
      height: 100%;
      background-color: transparent;
    }

    .event-premium-hero-mask-media {
      transform: translateZ(0);
    }
  }
</style>

<script is:inline>
  (() => {
    const MOBILE_MQ = '(max-width: 767px)';
    const isMobileViewport = () => window.matchMedia(MOBILE_MQ).matches;

    const preferredSrc = (video) =>
      isMobileViewport()
        ? video.dataset.srcMobile || video.dataset.srcDesktop
        : video.dataset.srcDesktop || video.dataset.srcMobile;

    const preferredPoster = (video) =>
      isMobileViewport() ? video.dataset.posterMobile : video.dataset.posterDesktop;

    const forceMutedInline = (video) => {
      // Safari checks the muted *state* at play() time; keep both attribute + properties.
      video.defaultMuted = true;
      video.muted = true;
      video.volume = 0;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('autoplay', '');
    };

    const ensureSource = (video) => {
      const nextSrc = preferredSrc(video);
      if (!nextSrc) return false;

      const absolute = new URL(nextSrc, window.location.href).href;
      const current = video.currentSrc || video.getAttribute('src') || '';
      const currentAbs = current ? new URL(current, window.location.href).href : '';

      if (video.dataset.activeSrc === nextSrc || currentAbs === absolute) {
        video.dataset.activeSrc = nextSrc;
        return false;
      }

      // Avoid <source> children + .src/.load() races that abort Safari autoplay.
      while (video.firstChild) {
        video.removeChild(video.firstChild);
      }
      video.dataset.activeSrc = nextSrc;
      video.setAttribute('src', nextSrc);
      return true;
    };

    const tryPlay = (video) => {
      forceMutedInline(video);
      if (!video.paused && !video.ended && video.readyState >= 2) return;

      const attempt = video.play();
      if (attempt !== undefined && typeof attempt.then === 'function') {
        attempt.catch(() => {
          // Expected when media is not ready yet or Low Power Mode blocks autoplay.
        });
      }
    };

    const hidePoster = (video) => {
      const mask = video.closest('.event-premium-hero-mask');
      const poster = mask && mask.querySelector('[data-event-premium-hero-poster]');
      if (poster instanceof HTMLElement) poster.hidden = true;
    };

    const setupHeroVideo = (video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (video.dataset.heroAutoplayBound === 'true') return;
      video.dataset.heroAutoplayBound = 'true';

      const nextPoster = preferredPoster(video);
      if (nextPoster) video.poster = nextPoster;

      forceMutedInline(video);
      ensureSource(video);

      const onReady = () => tryPlay(video);
      ['loadedmetadata', 'loadeddata', 'canplay', 'canplaythrough', 'playing'].forEach((evt) => {
        video.addEventListener(evt, onReady);
      });
      video.addEventListener('playing', () => hidePoster(video));

      // Safari often misses the first play() if it races load; poll briefly.
      let ticks = 0;
      const poll = window.setInterval(() => {
        ticks += 1;
        if (!video.paused || ticks > 40) {
          window.clearInterval(poll);
          return;
        }
        tryPlay(video);
      }, 250);

      tryPlay(video);

      const onVisible = () => {
        if (document.visibilityState === 'visible') tryPlay(video);
      };
      document.addEventListener('visibilitychange', onVisible);
      window.addEventListener('pageshow', onVisible);

      // Low Power Mode / strict autoplay: start on first gesture (still muted).
      const unlock = () => tryPlay(video);
      window.addEventListener('touchstart', unlock, { once: true, passive: true });
      window.addEventListener('click', unlock, { once: true });
      window.addEventListener('scroll', unlock, { once: true, passive: true });
    };

    const syncAll = () => {
      document.querySelectorAll('[data-event-premium-hero-video]').forEach((el) => {
        if (!(el instanceof HTMLVideoElement)) return;
        const nextPoster = preferredPoster(el);
        if (nextPoster && el.poster !== nextPoster) el.poster = nextPoster;
        const changed = ensureSource(el);
        if (changed || el.paused) tryPlay(el);
      });
    };

    document.querySelectorAll('[data-event-premium-hero-video]').forEach(setupHeroVideo);
    window.addEventListener('resize', syncAll, { passive: true });
  })();
</script>
